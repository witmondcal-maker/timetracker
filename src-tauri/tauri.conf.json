{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rastreador",
  "version": "0.1.0",
  "identifier": "com.rastreador.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rastreador",
        "width": 360,
        "height": 560,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "center": false,
        "visible": false,
        "backgroundColor": "#0e0e0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
